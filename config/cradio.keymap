#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
};

&lt {
    tapping-term-ms = <250>;
    retro-tap;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_bkspc {
            bindings = <&kp BACKSPACE>;
            key-positions = <9 8>;
        };

        combo_hyper {
            bindings = <&kp LA(LC(LS(LG(LEFT_GUI))))>;
            key-positions = <20 10>;
        };

        combo_meh {
            bindings = <&kp LA(LC(LEFT_SHIFT))>;
            key-positions = <29 19>;
        };

        combo_adjust {
            bindings = <&mo 0>;
            key-positions = <32 31>;
        };
    };

    behaviors {
        hold_bootloader_3s: hold_bootloader_3s {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_BOOTLOADER_3S";
            bindings = <&bootloader>, <&none>;
            #binding-cells = <2>;
            tapping-term-ms = <3000>;
        };

        hold_reset_3s: hold_reset_3s {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_RESET_3S";
            bindings = <&sys_reset>, <&none>;
            #binding-cells = <2>;
            tapping-term-ms = <3000>;
        };

        hold_bt_clear_3s: hold_bt_clear_3s {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_BT_CLEAR_3S";
            bindings = <&bt_clear>, <&none>;
            #binding-cells = <2>;
            tapping-term-ms = <3000>;
        };

        hold_bt_clear_all_5s: hold_bt_clear_all_5s {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_BT_CLEAR_ALL_5S";
            bindings = <&none>, <&none>;
            #binding-cells = <2>;
            tapping-term-ms = <5000>;
        };

        hmrl: hmrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR Left";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        hmrr: hmrr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR Right";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        bt_clear: bt_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
            label = "BT_CLEAR";
        };

        bt_clear_all: bt_clear_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR_ALL>;
            label = "BT_CLEAR_ALL";
        };

        ss_full: ss_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(NUMBER_3))>;
            label = "SS_FULL";
        };

        ss_area: ss_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(NUMBER_4))>;
            label = "SS_AREA";
        };

        ss_tools: ss_tools {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(N5))>;
            label = "SS_TOOLS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
                &kp Q             &kp W               &kp E             &kp R             &kp T          &kp Y        &kp U              &kp I          &kp O                &kp P
                &hmrl LEFT_ALT A  &hmrl LEFT_SHIFT S  &hmrl LCTRL D     &hmrl LEFT_GUI F  &kp G          &kp H        &hmrr RIGHT_GUI J  &hmrr RCTRL K  &hmrr RIGHT_SHIFT L  &kp SEMI
                &kp Z             &kp X               &kp C             &kp V             &kp B          &kp N        &kp M              &kp COMMA      &kp DOT              &kp FSLH
                                                           &kp LEFT_SHIFT  &lt 1 SPACE    &lt 2 ENTER  &kp RIGHT_ALT
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
                &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3              &kp NUMBER_4                 &kp N5                  &kp NUMBER_6           &kp N7                         &kp NUMBER_8               &kp N9                  &kp N0
                &trans        &trans        &hmrl LEFT_CONTROL GRAVE  &hmrl LEFT_GUI LEFT_BRACKET  &kp LEFT_BRACE          &kp RIGHT_BRACE        &hmrr RIGHT_GUI RIGHT_BRACKET  &hmrr RIGHT_CONTROL MINUS  &hmrr RIGHT_SHIFT PLUS  &kp SQT
                &trans        &trans        &trans                    &kp LESS_THAN                &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp GREATER_THAN               &kp UNDERSCORE             &kp EQUAL               &kp BSLH
                                                                 &trans                       &trans                  &mo 3                  &bspc_del
            >;
        };

        nav_layer {
            label = "NAVI";
            bindings = <
                &trans  &trans  &trans  &kp ENTER  &trans  &kp TAB   &kp GRAVE      &kp PAGE_UP   &kp HOME   &trans
                &trans  &trans  &trans  &trans     &trans  &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &trans
                &trans  &trans  &trans  &trans     &kp DEL  &trans    &kp PAGE_DOWN  &kp END       &trans     &trans
                                             &trans  &mo 3  &trans  &trans
            >;
        };

        adjust_layer {
            label = "ADJ";
            bindings = <
                &trans  &bt BT_SEL 0           &bt BT_SEL 1               &bt BT_SEL 2             &bt BT_SEL 3          &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC      &kp C_PREV  &ss_full   &trans
                &trans  &trans                 &trans                     &trans                   &trans                &kp C_MUTE       &kp C_BRIGHTNESS_MAXIMUM  &kp C_PP    &ss_area   &trans
                &trans  &hold_bt_clear_3s 0 0  &hold_bt_clear_all_5s 0 0  &hold_bootloader_3s 0 0  &hold_reset_3s 0 0    &kp C_VOL_DN     &kp C_BRIGHTNESS_DEC      &kp C_NEXT  &ss_tools  &trans
                                                                        &trans                   &trans                &trans           &trans
            >;
        };
    };
};
